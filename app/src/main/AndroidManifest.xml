<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- To know when internet comes back, and send what was changed without it. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Switch-off timers fire at the minute that was asked for and survive a restart of the phone. -->
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Temperature alerts and the outcome of switch-off timers. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Lets the app hand a downloaded update to Android's installer. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Writes the tags that switch devices, and reads them. Phones without NFC install it too. -->
    <uses-permission android:name="android.permission.NFC" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- The calendars of the phone, when there is no home server to read Google Calendar from. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <!-- The panel of the assistant listens by itself, showing the words as they are said. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- The music player goes on in the background, with its notification. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-feature
        android:name="android.hardware.nfc"
        android:required="false" />

    <!-- "Apri telefono" con la voce: serve vedere le app che hanno un'icona nel launcher. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".App"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Hommaterial">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Lets Android offer the app as the default digital assistant: its gesture opens a panel
             over the screen, listening, instead of the whole app. -->
        <activity
            android:name=".AssistActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@style/Theme.Hommaterial.Assist">
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity
            android:name=".quick.ToggleActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay" />
        <!-- A tag written by the app: Android opens this even with the app closed. -->
        <activity
            android:name=".quick.NfcActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:showWhenLocked="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.nfc.action.NDEF_DISCOVERED" />
                <category android:name="android.intent.category.DEFAULT" />
                <data
                    android:host="nfc"
                    android:scheme="hommaterial" />
            </intent-filter>
        </activity>
        <receiver
            android:name=".quick.ToggleReceiver"
            android:exported="false" />
        <service
            android:name=".quick.PowerTile1"
            android:exported="true"
            android:icon="@drawable/ic_power"
            android:label="Hommaterial 1"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <service
            android:name=".quick.PowerTile2"
            android:exported="true"
            android:icon="@drawable/ic_power"
            android:label="Hommaterial 2"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <service
            android:name=".quick.PowerTile3"
            android:exported="true"
            android:icon="@drawable/ic_power"
            android:label="Hommaterial 3"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <service
            android:name=".quick.PowerTile4"
            android:exported="true"
            android:icon="@drawable/ic_power"
            android:label="Hommaterial 4"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <service
            android:name=".quick.PowerTile5"
            android:exported="true"
            android:icon="@drawable/ic_power"
            android:label="Hommaterial 5"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <service
            android:name=".quick.PowerTile6"
            android:exported="true"
            android:icon="@drawable/ic_power"
            android:label="Hommaterial 6"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <service
            android:name=".quick.PowerTile7"
            android:exported="true"
            android:icon="@drawable/ic_power"
            android:label="Hommaterial 7"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <service
            android:name=".quick.PowerTile8"
            android:exported="true"
            android:icon="@drawable/ic_power"
            android:label="Hommaterial 8"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <service
            android:name=".quick.PowerTile9"
            android:exported="true"
            android:icon="@drawable/ic_power"
            android:label="Hommaterial 9"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <service
            android:name=".quick.PowerTile10"
            android:exported="true"
            android:icon="@drawable/ic_power"
            android:label="Hommaterial 10"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <receiver
            android:name=".quick.HomeWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/home_widget" />
        </receiver>
        <receiver
            android:name=".quick.ListsWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_lists_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/lists_widget" />
        </receiver>
        <receiver
            android:name=".quick.AgendaWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_agenda_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/agenda_widget" />
        </receiver>
        <receiver
            android:name=".quick.TeamWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_team_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/team_widget" />
        </receiver>
        <receiver
            android:name=".quick.TeamReminderReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".quick.ScheduleReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".quick.TimerReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
        <service
            android:name=".music.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_paths" />
        </provider>
    </application>

</manifest>
