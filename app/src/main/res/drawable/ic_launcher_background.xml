<?xml version="1.0" encoding="utf-8"?>
<!-- Background of the launcher icon: a blue that deepens towards the lower right corner. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <!-- Spread over the part the launcher shows, not over the whole layer. -->
            <gradient
                android:endColor="#FF1A3FB0"
                android:endX="90"
                android:endY="90"
                android:startColor="#FF3D8BFF"
                android:startX="18"
                android:startY="18"
                android:type="linear" />
        </aapt:attr>
    </path>
</vector>
