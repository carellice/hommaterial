    <string name="feature_1">Shows the devices linked to your Alexa account, grouped by room.</string>
    <string name="feature_2">A tap turns lights, plugs, TVs and switches on or off.</string>
    <string name="feature_3">Press and hold a device to adjust its brightness or hide it.</string>
    <string name="feature_4">Reads temperature and humidity from sensors.</string>
