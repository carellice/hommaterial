    <string name="warning_1_title">It is not an official app</string>
    <string name="warning_1_text">Hommaterial is not affiliated with, approved or supported by Amazon. Amazon, Alexa and Echo are trademarks of Amazon.com, Inc. or its affiliates.</string>
    <string name="warning_2_title">It uses unofficial APIs</string>
    <string name="warning_2_text">The app talks to Amazon\'s servers presenting itself as the official Alexa app. This most likely violates Amazon\'s terms of use.</string>
    <string name="warning_3_title">Your account is at risk</string>
    <string name="warning_3_text">Amazon may restrict, suspend or close accounts that use unauthorized apps, and the app may stop working at any time.</string>
    <string name="warning_4_title">It handles access to your account</string>
    <string name="warning_4_text">You sign in on Amazon\'s page shown inside the app. The password is neither read nor saved, but a token that gives access to your Alexa account stays on the phone. Only use versions you trust.</string>
    <string name="warning_5_title">It controls real devices</string>
    <string name="warning_5_text">A bug in the app or a wrong tap turns real things in your home on or off, such as heaters and air conditioners.</string>
    <string name="warning_6_title">No warranty</string>
    <string name="warning_6_text">The software is provided as is. The authors are not liable for damage, account suspensions or other consequences of its use.</string>
